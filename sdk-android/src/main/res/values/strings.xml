    <string name="gap_reminder_missed_referral_for_danger_signs">If you see any danger sign, refer without delay — same-day referral saves lives.</string>
    <string name="gap_reminder_generic_hypertension">Reinforce the BP-control routine — daily medicine, less salt, daily walking.</string>
    <string name="gap_reminder_generic_diabetes">Reinforce the diabetes routine — regular FBS check, less sugar, watch the feet.</string>
    <string name="gap_reminder_generic_maternal_health">Reinforce the ANC routine — 4 visits, iron-folic acid, danger-sign awareness.</string>
    <string name="gap_reminder_generic_default">Use this as a reinforcement opportunity — ask the patient to repeat the key points back to you.</string>

